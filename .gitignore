# Flutter
android/app/.dart_tool/
android/app/.flutter-plugins*
android/app/build/
android/app/android/.gradle/
android/app/android/local.properties
android/app/*.iml

# Rust
android/komga_core/target/

# The frb-drift check's own scratch copy (scripts/verify.sh restores and deletes it;
# a leftover means the run was interrupted, never work in progress)
android/app/.frb-verify-backup.*/

# FRB cross-compiled Android libraries (regenerate with scripts/frb_wire.sh)
android/app/android/app/src/main/jniLibs/

# Tooling memory / scratch
.workbuddy/
