# macOS
.DS_Store
*.swp

# Xcode
DerivedData/
xcuserdata/
*.xcuserdatad/
# XcodeGen-generated project (regenerate with `xcodegen generate`)
ComicApp.xcodeproj

# SwiftPM
.build/
