        "maxBytes": 33554432,
        "reader": null,
        "books": [
          {
            "bookId": "b1",
            "position": 1,
            "state": "waiting",
            "allowCellular": false,
            "nextRetryAt": null,
            "pagesTotal": 6,
            "pages": [
              {
                "number": 1,
                "state": "pending",
                "attempts": 0,
                "declaredBytes": 19570
              },
              {
                "number": 2,
                "state": "pending",
                "attempts": 0,
                "declaredBytes": 19570
              }
            ]
          },
          {
            "bookId": "b2",
            "position": 2,
            "state": "waiting",
            "allowCellular": false,
            "nextRetryAt": null,
            "pagesTotal": 6,
            "pages": [
              {
                "number": 1,
                "state": "pending",
                "attempts": 0,
                "declaredBytes": 19570
              }
            ]
          }
        ]
      },
      "expect": {
        "jobs": [
          {
            "bookId": "b1",
            "page": 1
          },
          {
            "bookId": "b1",
            "page": 2
          }
        ],
        "stopReason": "drained"
      }
    },
