      "intent": {
        "type": "MARK_READ"
      },
      "local_updated_at": "2026-08-28T10:00:00Z",
      "refetch": {
        "status": 200,
        "page": 12,
        "completed": false,
        "progressLastModified": "2026-08-28T11:00:00Z",
        "mediaType": "application/zip"
      },
      "expected": {
        "decision": "upload",
        "packets": [
          {
            "method": "PATCH",
            "path": "/api/v1/books/book-1/read-progress",
            "body": {
              "completed": true
            }
          }
        ]
      }
    },
