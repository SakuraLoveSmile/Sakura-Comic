{
  "description": "Conflict resolution before upload. Inputs are always: the queued intent, the local row's action time (local_updated_at), and the result of the mandatory Targeted Re-fetch. Output is one decision. FORBIDDEN shortcuts, pinned by the two anti-max cases and by offline-wins cases: (a) Server Always Wins, (b) max(page). Rules R1-R5 are matched in order, first hit wins. `packets` lists the exact wire calls the uploader must make, in order.",
  "decisions": [
    "upload",
    "drop_success",
    "drop_remote_wins",
    "drop_gone",
    "defer",
    "drop_no_op",
    "unsupported_format"
  ],
  "rules": {
    "R1": "refetch says the entity no longer exists -> drop_gone",
    "R2": "intent is an explicit MARK_READ / MARK_UNREAD -> upload unconditionally, a remote passive value never outranks an explicit mark",
    "R3": "server already equals the intent -> drop_success without sending a packet",
    "R4": "progressLastModified is strictly newer than local_updated_at -> drop_remote_wins (latest user action wins, decided by time only). The stamp is ReadProgressDto.lastModified - the progress row's own timestamp, `required` on the wire. BookDto.lastModified must NEVER be substituted: it does not advance when read progress changes, which would make R4 blind to every remote read.",
    "R5": "otherwise -> upload",
    "R6": "refetch itself failed (transport/auth) -> defer, do not write blind; counted as a retryable failure",
    "R7": "passive progress with no page (or page 0) and completed=false says nothing the server can accept -> drop_no_op: no packet, queue cleared, counted as neither success nor failure",
    "R8": "a passive page progress on a reflowable book (epub, or pdf that is not Divina compatible) cannot go through read-progress at all -> unsupported_format: no packet, row parked with that reason, never retried into a 400 storm. Mark Read / Mark Unread stay supported for every format."
  },
  "cases": [
    {
      "name": "R5 offline read beats an older, further-along server value (not max(page), not server-wins)",
      "intent": {
        "type": "READ_PROGRESS",
        "page": 3,
        "completed": false
      },
      "local_updated_at": "2026-08-28T11:00:00Z",
      "refetch": {
        "status": 200,
        "page": 90,
        "completed": false,
        "progressLastModified": "2026-08-28T10:00:00Z",
        "mediaType": "application/zip"
      },
      "expected": {
        "decision": "upload",
        "packets": [
          {
            "method": "PATCH",
            "path": "/api/v1/books/book-1/read-progress",
            "body": {
              "page": 3,
              "completed": false
            }
          }
        ]
      }
    },
    {
      "name": "R4 remote action is strictly later -> remote wins even though its page is smaller (not max(page))",
      "intent": {
        "type": "READ_PROGRESS",
        "page": 90,
        "completed": false
      },
      "local_updated_at": "2026-08-28T10:00:00Z",
      "refetch": {
        "status": 200,
        "page": 3,
        "completed": false,
        "progressLastModified": "2026-08-28T11:00:00Z",
        "mediaType": "application/zip"
      },
      "expected": {
        "decision": "drop_remote_wins",
        "packets": [],
        "local_row_after_mirror": {
          "page": 3,
          "completed": false
        }
      }
    },
    {
      "name": "R5 the plain offline-reading case: server untouched since our base -> local wins",
      "intent": {
        "type": "READ_PROGRESS",
        "page": 30,
        "completed": false
      },
      "local_updated_at": "2026-08-28T10:05:00Z",
      "refetch": {
        "status": 200,
        "page": 5,
        "completed": false,
        "progressLastModified": "2026-08-28T09:00:00Z",
        "mediaType": "application/zip"
      },
      "expected": {
        "decision": "upload",
        "packets": [
          {
            "method": "PATCH",
            "path": "/api/v1/books/book-1/read-progress",
            "body": {
              "page": 30,
              "completed": false
            }
          }
        ]
      }
    },
